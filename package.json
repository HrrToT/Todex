{
  "name": "todex",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm --filter @todex/contracts build && pnpm --filter @todex/harness-core build && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "lint": "eslint .",
    "build": "pnpm -r build",
    "demo:mechanisms": "tsx scripts/run-mechanism-demo.ts",
    "package:desktop-release": "pnpm --filter @todex/desktop package:win && pnpm verify:desktop-package",
    "verify:desktop-package": "tsx scripts/verify-desktop-package.ts",
    "verify:release": "tsx scripts/verify-release.ts"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.8",
    "zod": "^3.23.8"
  }
}
